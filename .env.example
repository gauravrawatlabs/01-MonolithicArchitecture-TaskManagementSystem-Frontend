# ------------------------------------------------------------------------------------------------
# Environment variables for the Task Management System frontend.
#
# Only variables prefixed with VITE_ are exposed to the browser code, and EVERYTHING here ends up
# inside the public JavaScript bundle. Never put secrets (passwords, API keys, signing keys) in it.
#
# Files (loaded by Vite according to the mode):
#   .env.development        committed   used by `npm run dev`
#   .env.test               committed   used by Vitest
#   .env.production.local   git-ignored used by `npm run build` on your machine (copy this file)
#   CI / hosting            set VITE_API_BASE_URL as a real environment variable for production builds
# ------------------------------------------------------------------------------------------------

# Base URL of the ASP.NET Core Web API, without a trailing slash and without /api.
VITE_API_BASE_URL=http://localhost:5075

# Optional: name shown in the browser tab and the sidebar.
VITE_APP_NAME=Task Management System
